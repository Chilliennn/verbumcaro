{
  "translationId": "sigao",
  "book": "1CH",
  "chapter": 1,
  "verses": [
    {
      "verse": 1,
      "heading": "从亚当到亚巴郎的族谱",
      "text": "亚当、舍特、厄诺士、",
      "footnotes": []
    },
    {
      "verse": 2,
      "heading": null,
      "text": "刻南、玛拉肋耳、耶勒得、",
      "footnotes": []
    },
    {
      "verse": 3,
      "heading": null,
      "text": "哈诺客、默突舍拉、拉默客、",
      "footnotes": []
    },
    {
      "verse": 4,
      "heading": null,
      "text": "诺厄、闪、含和耶斐特。",
      "footnotes": []
    },
    {
      "verse": 5,
      "heading": null,
      "text": "耶斐特的子孙：哥默尔、玛哥格、玛待、雅汪、突巴耳、默舍客和提辣斯。",
      "footnotes": []
    },
    {
      "verse": 6,
      "heading": null,
      "text": "哥默尔的子孙：阿市革纳次、黎法特和托加尔玛。",
      "footnotes": []
    },
    {
      "verse": 7,
      "heading": null,
      "text": "雅汪的子孙：厄里沙、塔尔史士、基廷和多丹。",
      "footnotes": []
    },
    {
      "verse": 8,
      "heading": null,
      "text": "含的子孙：雇士、米兹辣殷、普特和客纳罕。",
      "footnotes": []
    },
    {
      "verse": 9,
      "heading": null,
      "text": "雇士的子孙：色巴、哈威拉、撒贝达、辣阿玛和撒贝特加。辣阿玛的子孙：舍巴和德丹。",
      "footnotes": []
    },
    {
      "verse": 10,
      "heading": null,
      "text": "雇士生尼默洛得；他是世界第一个强人。",
      "footnotes": []
    },
    {
      "verse": 11,
      "heading": null,
      "text": "米兹辣殷生路丁人、阿纳明人、肋哈宾人、纳斐突歆（xīn）人、",
      "footnotes": []
    },
    {
      "verse": 12,
      "heading": null,
      "text": "帕特洛斯人，加斯路人和加非托尔人，即培肋舍特的祖先。",
      "footnotes": []
    },
    {
      "verse": 13,
      "heading": null,
      "text": "客纳罕生长子漆冬，次为赫特、",
      "footnotes": []
    },
    {
      "verse": 14,
      "heading": null,
      "text": "耶步斯人、阿摩黎人、基尔加史人、",
      "footnotes": []
    },
    {
      "verse": 15,
      "heading": null,
      "text": "希威人、阿尔克人、息尼人、",
      "footnotes": []
    },
    {
      "verse": 16,
      "heading": null,
      "text": "阿尔瓦得人、责玛黎人和哈玛特人。",
      "footnotes": []
    },
    {
      "verse": 17,
      "heading": null,
      "text": "闪的子孙：厄蓝、亚述、阿帕革沙得、路得、阿兰。阿兰的子孙：伍兹、胡耳、革特尔和默舍客。",
      "footnotes": []
    },
    {
      "verse": 18,
      "heading": null,
      "text": "阿帕革沙得生舍拉，舍拉生厄贝尔。",
      "footnotes": []
    },
    {
      "verse": 19,
      "heading": null,
      "text": "厄贝尔生了两个儿子：长子名叫培肋格，因为在他的时代，世界分裂了；他的兄弟名叫约刻堂。",
      "footnotes": []
    },
    {
      "verse": 20,
      "heading": null,
      "text": "约刻堂生阿耳摩达得、舍肋夫、哈匝玛委特、耶辣、",
      "footnotes": []
    },
    {
      "verse": 21,
      "heading": null,
      "text": "哈多兰、乌匝耳、狄刻拉、",
      "footnotes": []
    },
    {
      "verse": 22,
      "heading": null,
      "text": "厄巴耳、阿彼玛耳、舍巴、",
      "footnotes": []
    },
    {
      "verse": 23,
      "heading": null,
      "text": "敖非尔、哈威拉和约巴布：这些人都是约刻堂的子孙。",
      "footnotes": []
    },
    {
      "verse": 24,
      "heading": null,
      "text": "闪阿帕革沙得、舍拉、",
      "footnotes": []
    },
    {
      "verse": 25,
      "heading": null,
      "text": "厄贝尔、培肋格、勒伍、",
      "footnotes": []
    },
    {
      "verse": 26,
      "heading": null,
      "text": "色鲁格、纳曷（hé）尔、特辣黑、",
      "footnotes": []
    },
    {
      "verse": 27,
      "heading": null,
      "text": "亚巴郎即亚贝辣罕。",
      "footnotes": []
    },
    {
      "verse": 28,
      "heading": "亚巴郎的后代",
      "text": "亚巴郎的儿子是依撒格和依市玛耳。",
      "footnotes": []
    },
    {
      "verse": 29,
      "heading": null,
      "text": "以下是他们的后裔：依市玛耳的长子是乃巴约特，次为刻达尔、阿德贝耳、米贝散、",
      "footnotes": []
    },
    {
      "verse": 30,
      "heading": null,
      "text": "米市玛、杜玛、玛萨、哈达得、特玛、",
      "footnotes": []
    },
    {
      "verse": 31,
      "heading": null,
      "text": "耶突尔、纳菲士和刻德玛：以上是依市玛耳的儿子。",
      "footnotes": []
    },
    {
      "verse": 32,
      "heading": null,
      "text": "亚巴郎的妾刻突辣所生的儿子：齐默郎、约刻商、默丹、米德杨、依市巴克和叔哈；约刻商的儿子：舍巴和德丹。",
      "footnotes": []
    },
    {
      "verse": 33,
      "heading": null,
      "text": "米德杨的儿子：厄法、厄斐尔、哈诺客、阿彼达和厄耳达阿：以上都是刻突辣的子孙。",
      "footnotes": []
    },
    {
      "verse": 34,
      "heading": null,
      "text": "亚巴郎生依撒格；依撒格生厄撒乌和以色列。",
      "footnotes": []
    },
    {
      "verse": 35,
      "heading": null,
      "text": "厄撒乌的儿子：厄里法次、勒乌耳、耶乌士、雅蓝和科辣黑。",
      "footnotes": []
    },
    {
      "verse": 36,
      "heading": null,
      "text": "厄里法次的子孙：特曼、敖玛尔、则非、加堂、刻纳次、提默纳和阿玛肋克。",
      "footnotes": []
    },
    {
      "verse": 37,
      "heading": null,
      "text": "勒乌耳的子孙：纳哈特、则辣黑、沙玛和米匝。",
      "footnotes": []
    },
    {
      "verse": 38,
      "heading": "色依尔后裔",
      "text": "色依尔的子孙：罗堂、芍巴耳、漆贝红、阿纳、狄雄、厄责尔和狄商。",
      "footnotes": []
    },
    {
      "verse": 39,
      "heading": null,
      "text": "罗堂的儿子：曷黎和曷曼；罗堂的姊妹：提默纳。",
      "footnotes": []
    },
    {
      "verse": 40,
      "heading": null,
      "text": "芍巴耳的儿子：阿里杨、玛纳哈特、厄巴耳、舍非和敖南。漆贝红的儿子：阿雅和阿纳。",
      "footnotes": []
    },
    {
      "verse": 41,
      "heading": null,
      "text": "阿纳的儿子：狄雄；狄雄的儿子：哈默郎、厄市班、依特郎和革郎。",
      "footnotes": []
    },
    {
      "verse": 42,
      "heading": null,
      "text": "厄责尔的儿子：彼耳汉、匝汪和阿甘。狄商的儿子：伍兹和阿郎。",
      "footnotes": []
    },
    {
      "verse": 43,
      "heading": "厄东的君王",
      "text": "以下是在以色列子民未有君王统治以前，统治厄东地的君王：贝敖尔的儿子贝拉，他的京城名叫丁哈巴。",
      "footnotes": []
    },
    {
      "verse": 44,
      "heading": null,
      "text": "贝拉死后，波责辣人则辣黑的儿子约巴布继他为王。",
      "footnotes": []
    },
    {
      "verse": 45,
      "heading": null,
      "text": "约巴布死后，特曼地人胡商继他为王。",
      "footnotes": []
    },
    {
      "verse": 46,
      "heading": null,
      "text": "胡商死后，贝达得的儿子哈达得继他为王。他曾在摩阿布平原击败了米德杨人；他的京城名叫阿威特。",
      "footnotes": []
    },
    {
      "verse": 47,
      "heading": null,
      "text": "哈达得死后，玛斯勒卡人撒默拉继他为王。",
      "footnotes": []
    },
    {
      "verse": 48,
      "heading": null,
      "text": "撒默拉死后，河间的勒曷波特人沙乌耳继他为王。",
      "footnotes": []
    },
    {
      "verse": 49,
      "heading": null,
      "text": "沙乌耳死后，阿革波尔的儿子巴耳哈南继他为王。",
      "footnotes": []
    },
    {
      "verse": 50,
      "heading": null,
      "text": "巴耳哈南死后，哈达得继他为王，他的京城名叫帕依，他的妻子名叫默塔贝耳，是默匝哈布人玛特勒得的女儿。",
      "footnotes": []
    },
    {
      "verse": 51,
      "heading": "厄东的族长",
      "text": "哈达得死后，为厄东族长的是：提默纳族长，阿里雅族长，耶太特族长，",
      "footnotes": []
    },
    {
      "verse": 52,
      "heading": null,
      "text": "敖曷里巴玛族长，厄拉族长，丕农族长，",
      "footnotes": []
    },
    {
      "verse": 53,
      "heading": null,
      "text": "刻纳次族长，特曼族长，米贝匝尔族长，",
      "footnotes": []
    },
    {
      "verse": 54,
      "heading": null,
      "text": "玛革狄耳族长和依兰族长：以上是厄东的族长。",
      "footnotes": []
    }
  ]
}