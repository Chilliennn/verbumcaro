{
  "translationId": "shinkyo",
  "book": "PSA",
  "chapter": 20,
  "verses": [
    {
      "verse": 1,
      "heading": null,
      "text": "【指揮者によって。賛歌。ダビデの詩。】",
      "footnotes": []
    },
    {
      "verse": 2,
      "heading": null,
      "text": "苦難の日に主があなたに答え ヤコブの神の御名があなたを高く上げ",
      "footnotes": []
    },
    {
      "verse": 3,
      "heading": null,
      "text": "聖所から助けを遣わし シオンからあなたを支えてくださるように。",
      "footnotes": []
    },
    {
      "verse": 4,
      "heading": null,
      "text": "あなたの供え物をことごとく心に留め あなたのいけにえを快く受け入れ〔セラ",
      "footnotes": []
    },
    {
      "verse": 5,
      "heading": null,
      "text": "あなたの心の願いをかなえ あなたの計らいを実現させてくださるように。",
      "footnotes": []
    },
    {
      "verse": 6,
      "heading": null,
      "text": "我らがあなたの勝利に喜びの声をあげ 我らの神の御名によって 旗を掲げることができるように。 主が、あなたの求めるところを すべて実現させてくださるように。",
      "footnotes": []
    },
    {
      "verse": 7,
      "heading": null,
      "text": "今、わたしは知った 主は油注がれた方に勝利を授け 聖なる天から彼に答えて 右の御手による救いの力を示されることを。",
      "footnotes": []
    },
    {
      "verse": 8,
      "heading": null,
      "text": "戦車を誇る者もあり、馬を誇る者もあるが 我らは、我らの神、主の御名を唱える。",
      "footnotes": []
    },
    {
      "verse": 9,
      "heading": null,
      "text": "彼らは力を失って倒れるが 我らは力に満ちて立ち上がる。",
      "footnotes": []
    },
    {
      "verse": 10,
      "heading": null,
      "text": "主よ、王に勝利を与え 呼び求める我らに答えてください。",
      "footnotes": []
    }
  ]
}