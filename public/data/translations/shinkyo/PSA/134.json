  "verses": [
    {
      "verse": 1,
      "heading": null,
      "text": "【都に上る歌。】 主の僕らよ、こぞって主をたたえよ。 夜ごと、主の家にとどまる人々よ",
      "footnotes": []
    },
    {
      "verse": 2,
      "heading": null,
      "text": "聖所に向かって手を上げ、主をたたえよ。",
      "footnotes": []
    },
    {
      "verse": 3,
      "heading": null,
      "text": "天地を造られた主が シオンからあなたを祝福してくださるように。",
      "footnotes": []
    }
  ]
}