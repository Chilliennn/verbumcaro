{
  "translationId": "shinkyo",
  "book": "PSA",
  "chapter": 114,
  "verses": [
    {
      "verse": 1,
      "heading": null,
      "text": "イスラエルはエジプトを ヤコブの家は異なる言葉の民のもとを去り",
      "footnotes": []
    },
    {
      "verse": 2,
      "heading": null,
      "text": "ユダは神の聖なるもの イスラエルは神が治められるものとなった。",
      "footnotes": []
    },
    {
      "verse": 3,
      "heading": null,
      "text": "海は見て、逃げ去った。 ヨルダンの流れは退いた。",
      "footnotes": []
    },
    {
      "verse": 4,
      "heading": null,
      "text": "山々は雄羊のように 丘は群れの羊のように踊った。",
      "footnotes": []
    },
    {
      "verse": 5,
      "heading": null,
      "text": "どうしたのか、海よ、逃げ去るとは ヨルダンの流れよ、退くとは",
      "footnotes": []
    },
    {
      "verse": 6,
      "heading": null,
      "text": "山々よ、雄羊のように 丘よ、群れの羊のように踊るとは。",
      "footnotes": []
    },
    {
      "verse": 7,
      "heading": null,
      "text": "地よ、身もだえせよ、主なる方の御前に ヤコブの神の御前に",
      "footnotes": []
    },
    {
      "verse": 8,
      "heading": null,
      "text": "岩を水のみなぎるところとし 硬い岩を水の溢れる泉とする方の御前に。",
      "footnotes": []
    }
  ]
}